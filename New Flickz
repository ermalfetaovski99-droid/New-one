local function mainTab()
 local mp=X.addTab("MAIN")
 local S={noc=false,spd=false,fs=60,walk=100}
 local flying=false
 local bv,bg=nil,nil
 local function setFly(on)
  flying=on
  if bv then bv:Destroy() bv=nil end
  if bg then bg:Destroy() bg=nil end
  local _,hrp,hum=chr()
  if hum then hum.PlatformStand=false end
  if on and hrp and hum then
   bv=mk("BodyVelocity",{MaxForce=Vector3.new(1e9,1e9,1e9),Velocity=Vector3.new(0,0,0)},hrp)
   bg=mk("BodyGyro",{MaxTorque=Vector3.new(1e9,1e9,1e9),P=1e4,CFrame=hrp.CFrame},hrp)
   hum.PlatformStand=true
  end
 end
 table.insert(X.cons,R.Heartbeat:Connect(function()
  local _,hrp,hum=chr()
  if not hum then return end
  if S.spd then hum.WalkSpeed=S.walk end
  if flying and bv and bg and hrp then
   local cam=workspace.CurrentCamera
   local m=cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
   bv.Velocity=(cam.CFrame.RightVector*m.X+cam.CFrame.LookVector*-m.Z)*S.fs
   bg.CFrame=cam.CFrame
  end
 end))
 table.insert(X.cons,R.Stepped:Connect(function()
  local c=lp.Character
  if S.noc and c then
   for _,p in ipairs(c:GetDescendants()) do
    if p:IsA("BasePart") then p.CanCollide=false end
   end
  end
 end))
 table.insert(X.cons,lp.CharacterAdded:Connect(function()
  task.wait(.6)
  if flying then setFly(true) end
 end))
 table.insert(X.cleanup,function()
  setFly(false)
  S.noc=false S.spd=false
  local _,_,h=chr()
  if h then h.WalkSpeed=16 end
 end)

 X.tog(mp,"Fly",function(v) setFly(v) X.toast("Fly "..(v and "ON" or "OFF")) end)
 X.num(mp,"Fly speed",60,1,300,function(v) S.fs=v end)
 X.tog(mp,"Noclip",function(v) S.noc=v X.toast("Noclip "..(v and "ON" or "OFF")) end)
 X.tog(mp,"Speed",function(v)
  S.spd=v
  local _,_,h=chr()
  if h and not v then h.WalkSpeed=16 end
  X.toast("Speed "..(v and "ON" or "OFF"))
 end)
 X.num(mp,"Walk speed",100,1,500,function(v) S.walk=v end)
 X.btn(mp,"Respawn",function()
  local c,_,h=chr()
  if c then pcall(function() c:BreakJoints() end) end
  if h then h.Health=0 end
 end)
 X.btn(mp,"Leave Game",function() X.leaveGame() end,Color3.fromRGB(170,45,50))
end

